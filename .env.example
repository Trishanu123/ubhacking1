# Public Supabase (optional — app works in memory without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional for the existing demo. Photo recognition requires this key; the existing demo does not.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional override for property photos only. Defaults to OPENAI_MODEL.
OPENAI_VISION_MODEL=

# Optional NREL PVWatts key. Without it, solar uses a latitude-based yield estimate.
PVWATTS_API_KEY=
